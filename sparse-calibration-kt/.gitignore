# Ignore everything under data recursively (files and directories)
data/**

# Unignore all directories so Git can traverse them to find .gitkeep files
!data/**/

# Unignore .gitkeep files so they are tracked
!data/**/.gitkeep

# Predictions (large files)
results/predictions/

# Python environment & cache
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.ipynb_checkpoints/

# Virtual Environments
.venv/
env/
venv/
ENV/

# System / IDE settings
.vscode/
.idea/
.DS_Store
Thumbs.db

# Saved weights / Models
*.pt
*.pth
*.pkl
*.bin

# Log files
logs/
*.log
*.csv.log

# Word COM backups, lock files, and LaTeX aux
*.bak*
*.bak_pre_*
~$*
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.out
paper/*.synctex.gz

# IJIET a2b rerun dumps (multi-GB; GitHub 100 MB file cap)
IJIET_FINAL_REVISION/a2b/data/
IJIET_FINAL_REVISION/a2b/checkpoints/
IJIET_FINAL_REVISION/a2b/results/predictions/
IJIET_FINAL_REVISION/a2b/logs/
